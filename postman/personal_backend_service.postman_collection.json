  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// The service does not issue tokens: it only validates HS256 JWTs signed",
          "// with the shared secret (issued by the auth-service in production).",
          "// Whenever a request references the {{accessToken}} placeholder we mint a",
          "// fresh token on the fly so every request is self-contained. Requests",
          "// exercising auth failure paths (empty/expired bearer) opt out by not",
          "// referencing the variable. A manually provided token that is still",
          "// valid is left untouched.",
          "const wantsToken = (pm.request.headers.get('Authorization') || '').includes('{{accessToken}}')",
          "  || (pm.request.url.query && pm.request.url.query.toString().includes('{{accessToken}}'));",
          "const nowSec = Math.floor(Date.now() / 1000);",
          "const subject = pm.collectionVariables.get('jwtSubject') || 'postman-e2e';",
          "const cjs = require('crypto-js');",
          "const b64url = (value) => cjs.enc.Base64.stringify(",
          "  cjs.enc.Utf8.parse(JSON.stringify(value))",
          ").replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const tokenValid = (token) => {",
          "  try {",
          "    let payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
          "    payload += '='.repeat((4 - payload.length % 4) % 4);",
          "    const claims = JSON.parse(cjs.enc.Utf8.stringify(cjs.enc.Base64.parse(payload)));",
          "    return claims.exp > nowSec + 60;",
          "  } catch (error) {",
          "    return false;",
          "  }",
          "};",
          "const sign = (lifetimeSeconds) => {",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const payload = {",
          "    exp: nowSec + lifetimeSeconds,",
          "    iat: nowSec,",
          "    iss: 'auth-service',",
          "    jti: pm.variables.replaceIn('{{$guid}}'),",
          "    sub: subject,",
          "    user: { id: subject, email: 'postman-e2e@example.com', display_name: 'Postman E2E' },",
          "  };",
          "  const signingInput = b64url(header) + '.' + b64url(payload);",
          "  const signature = cjs.enc.Base64.stringify(",
          "    cjs.HmacSHA256(signingInput, pm.collectionVariables.get('jwtSecret'))",
          "  ).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "  return signingInput + '.' + signature;",
          "};",
          "if (wantsToken && !tokenValid(pm.collectionVariables.get('accessToken'))) {",
          "  pm.collectionVariables.set('accessToken', sign(3600));",
          "}"
        ]
      }
    }
